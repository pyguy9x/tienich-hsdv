{
  "manifest_version": 3,
  "name": "Điền hồ sơ đảng viên (thử nghiệm)-pickle",
  "version": "0.9.0",
  "description": "Điền tự động hồ sơ đảng viên từ Excel hoặc dữ liệu đã lưu trên đám mây: bước 1–10 (B11 do hệ thống tự ghi) – Hệ thống CSDL Đảng viên.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://tcxdd.dcs.vn/*",
    "https://hung-da4c1-default-rtdb.asia-southeast1.firebasedatabase.app/*"
  ],
  "action": {
    "default_title": "Điền hồ sơ đảng viên",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "bg.js"
  }
}